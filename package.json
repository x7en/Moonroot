{
  "name": "moonroot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint:eslint": "eslint .",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs core scripts tests",
    "lint:copy": "tsx scripts/lint-copy.ts",
    "lint": "npm run lint:eslint && npm run lint:deps && npm run lint:copy",
    "test": "vitest run",
    "rules:export": "tsx scripts/export-rules.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
