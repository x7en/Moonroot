{
  "name": "moonroot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint:eslint": "eslint .",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs core data app platform ui scripts tests",
    "lint:copy": "tsx scripts/lint-copy.ts",
    "lint": "npm run lint:eslint && npm run lint:deps && npm run lint:copy",
    "test": "vitest run",
    "rules:export": "tsx scripts/export-rules.ts",
    "widget:art": "tsx scripts/widget-art.ts",
    "android:verify": "tsx scripts/verify-android-manifest.ts",
    "sim": "tsx scripts/sim.ts",
    "build:core": "tsc -p tsconfig.build.json",
    "build": "npm run build:core && vite build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.6",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "4.14.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-window": "7.4.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "idb": "8.0.4",
    "preact": "11.2.0"
  }
}
